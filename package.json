{
  "name": "codey",
  "author": "nick1udwig",
  "version": "0.2.2",
  "description": "A streaming, agent-defined interface for Repebble watches.",
  "main": "src/common/index.js",
  "keywords": [
    "pebble-app",
    "repebble",
    "agent",
    "dynamic-ui"
  ],
  "private": true,
  "scripts": {
    "test": "node tests/run.js && node tests/collections.js && node tests/native/run.js && node tests/integration.mjs && go test ./...",
    "build:watch": "pebble build",
    "build:settings": "node scripts/build-settings-site.mjs",
    "build:server": "go build -o build/codey-server ./cmd/codey-server",
    "server": "go run ./cmd/codey-server",
    "demo:server": "node examples/server.mjs",
    "build:watch:release": "pebble build && python3 scripts/package-watch-release.py && CODEY_TEST_BUNDLE=../build/release/debug/pebble-js-app.js node tests/run.js"
  },
  "pebble": {
    "displayName": "codey",
    "uuid": "a59810b4-596d-4c6e-81ae-7f2152af8c17",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": {
      "MessageType": 0,
      "RequestId": 1,
      "Operation": 2,
      "Kind": 3,
      "ElementId": 4,
      "ParentId": 5,
      "Title": 6,
      "Subtitle": 7,
      "Value": 8,
      "Action": 9,
      "Meta": 10,
      "Flags": 11,
      "Index": 12,
      "CollectionProtocol": 13,
      "BridgeSession": 14,
      "EventSequence": 15,
      "ViewToken": 16,
      "DeliveryState": 17,
      "ErrorCode": 18
    },
    "resources": {
