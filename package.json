{
  "name": "codey",
  "author": "nick1udwig",
  "version": "0.1.0",
  "description": "A streaming, agent-defined interface for Repebble watches.",
  "main": "src/common/index.js",
  "keywords": [
    "pebble-app",
    "repebble",
    "agent",
    "dynamic-ui"
  ],
  "private": true,
  "scripts": {
    "test": "node tests/run.js && node tests/collections.js && node tests/native/run.js && node tests/integration.mjs && go test ./...",
    "build:watch": "pebble build",
    "build:settings": "node scripts/build-settings-site.mjs",
    "build:server": "go build -o build/codey-server ./cmd/codey-server",
    "server": "go run ./cmd/codey-server",
    "demo:server": "node examples/server.mjs"
  },
  "pebble": {
    "displayName": "codey",
    "uuid": "a59810b4-596d-4c6e-81ae-7f2152af8c17",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": {
      "MessageType": 0,
      "RequestId": 1,
      "Operation": 2,
      "Kind": 3,
      "ElementId": 4,
      "ParentId": 5,
      "Title": 6,
      "Subtitle": 7,
      "Value": 8,
      "Action": 9,
      "Meta": 10,
      "Flags": 11,
      "Index": 12,
      "CollectionProtocol": 13,
      "BridgeSession": 14,
      "EventSequence": 15,
      "ViewToken": 16,
      "DeliveryState": 17,
      "ErrorCode": 18
    },
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "DASH_CALENDAR",
          "file": "images/icon_calendar.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_WEATHER",
          "file": "images/icon_weather.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_CODEY_SLEEP_SMALL",
          "file": "images/codey_sleep_small.png",
          "storageFormat": "pbi",
          "memoryFormat": "4bitpalette"
        },
        {
          "type": "bitmap",
          "name": "DASH_CHAT",
          "file": "images/icon_chat.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_TODOS",
          "file": "images/icon_todos.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_TIMER",
          "file": "images/icon_timer.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_ALARM",
          "file": "images/icon_alarm.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_BELL",
          "file": "images/icon_bell.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_TIMER_SMALL",
          "file": "images/icon_timer_small.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_ALARM_SMALL",
          "file": "images/icon_alarm_small.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_BELL_SMALL",
          "file": "images/icon_bell_small.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_TODOS_SMALL",
          "file": "images/icon_todos_small.png"
        },
        {
          "type": "bitmap",
          "name": "DASH_CODEY_THINK_SMALL",
          "file": "images/codey_think_small.png",
          "storageFormat": "pbi",
          "memoryFormat": "4bitpalette"
        },
        {
          "type": "bitmap",
          "name": "DASH_CODEY_SLEEP_EMERY",
          "file": "images/codey_sleep_emery.png",
          "storageFormat": "pbi",
          "memoryFormat": "4bitpalette"
        },
        {
          "type": "bitmap",
          "name": "DASH_CODEY_THINK_EMERY",
          "file": "images/codey_think_emery.png",
          "storageFormat": "pbi",
          "memoryFormat": "4bitpalette"
        },
        {
          "type": "bitmap",
          "name": "DASH_CODEY_SLEEP_GABBRO",
          "file": "images/codey_sleep_gabbro.png",
          "storageFormat": "pbi",
          "memoryFormat": "4bitpalette"
        },
        {
          "type": "bitmap",
          "name": "DASH_CODEY_THINK_GABBRO",
          "file": "images/codey_think_gabbro.png",
          "storageFormat": "pbi",
          "memoryFormat": "4bitpalette"
        }
      ]
    }
  }
}
