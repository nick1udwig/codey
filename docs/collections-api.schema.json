{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codey.local/schemas/collections-api-v1",
  "title": "Collection mutation batch protocol 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "server_instance_id",
    "store_epoch",
    "client_id",
    "operations"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "server_instance_id": {
      "type": "string"
    },
    "store_epoch": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ingress_id",
        "sequence",
        "collection_id",
        "binding_generation",
        "record_id",
        "type",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ingress_id": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "collection_id": {
          "type": "string"
        },
        "binding_generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "record_id": {
          "type": "string"
        },
        "base_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "base_operation_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "task.create",
            "task.patch",
            "task.complete",
            "task.restore",
            "note.create",
            "note.append",
            "note.replace",
            "record.delete",
            "conflict.resolve"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
